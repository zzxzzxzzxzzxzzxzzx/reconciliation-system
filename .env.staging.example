# 复制为 .env.staging 后修改。密码仅使用大小写字母和数字，避免数据库连接串转义问题。
POSTGRES_DB=reconciliation_staging
POSTGRES_USER=reconciliation
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_password

# 对外访问端口。公司内网测试可使用 http://服务器IP:8080
TEST_HTTP_PORT=8080

# 仅用于后端 CORS 白名单；同域 /api 访问不依赖 CORS。
WEB_URL=http://127.0.0.1:8080

# 使用 scripts/generate-admin-credentials.sh 生成，部署时配置为真实值。
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace_with_generated_scrypt_hash
SESSION_SECRET=replace_with_generated_session_secret
COOKIE_SECURE=false
